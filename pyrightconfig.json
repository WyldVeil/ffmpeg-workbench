{
  "include": [
    "core",
    "shell",
    "tabs",
    "tests",
    "scripts",
    "devtools",
    "main.py"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "build",
    "dist",
    "libs",
    "bin"
  ],
  "extraPaths": [
    "."
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": "none",
  "strict": [
    "core",
    "shell",
    "tabs/kit"
  ]
}
