{
  "include": [
    "core",
    "shell",
    "tabs",
    "tests",
    "scripts",
    "devtools",
    "main.py"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "build",
    "dist",
    "libs",
    "bin"
  ],
  "extraPaths": [
    "."
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": "none",
  "strict": [
    "core/errors.py",
    "core/proc.py",
    "core/tasks.py",
    "core/timecode.py",
    "core/tools.py",
    "core/capabilities.py",
    "shell/chime.py",
    "shell/menus.py",
    "shell/pages.py",
    "shell/statusbar.py",
    "shell/versions.py",
    "shell/shortcuts.py",
    "tabs/kit/labels.py"
  ]
}
